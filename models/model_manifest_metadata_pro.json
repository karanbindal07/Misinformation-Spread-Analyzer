  "test_metrics": {
    "threshold": 0.5,
    "accuracy": 0.7637795275590551,
    "precision": 0.7384615384615385,
    "recall": 0.7868852459016393,
    "f1": 0.7619047619047619,
    "tp": 48,
    "fp": 17,
    "tn": 49,
    "fn": 13
